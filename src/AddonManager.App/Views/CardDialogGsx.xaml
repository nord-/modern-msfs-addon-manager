<UserControl x:Class="AddonManager.App.Views.CardDialogGsx"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AddonManager.App.Views"
             xmlns:vm="clr-namespace:AddonManager.App.ViewModels">
    <UserControl.Resources>
        <local:PresentToVisibilityConverter x:Key="Present" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- Display only: profile rows and search rows, collapsed when the card has neither. -->
    <StackPanel Visibility="{Binding Gsx.IsVisible, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="GSX" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding Gsx.Rows}">
            <ItemsControl.Resources>
                <DataTemplate DataType="{x:Type vm:GsxProfileRow}">
                    <DockPanel Margin="0,0,0,6">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dimmed}" Value="True">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <ui:Button DockPanel.Dock="Right" Content="Remove" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="Warning16" Foreground="#FFB000" Margin="0,0,8,0" VerticalAlignment="Center"
                                           ToolTip="{Binding TwoProfilesTip}"
                                           Visibility="{Binding TwoProfilesTip, Converter={StaticResource Present}}" />
                            <TextBlock Text="{Binding Label}" Opacity="0.8" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Visibility="{Binding Label, Converter={StaticResource Present}}" />
                            <TextBlock VerticalAlignment="Center" Visibility="{Binding OnCard, Converter={StaticResource Present}}">
                                <Run Text="on" />
                                <Hyperlink Command="{Binding DataContext.ShowCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding OnCard.Ref}">
                                    <Run Text="{Binding OnCard.Name, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </WrapPanel>
                    </DockPanel>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:GsxSearchRow}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Code.Value}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:Button Icon="{ui:SymbolIcon Search20}" ToolTip="{Binding Tip}" VerticalAlignment="Center"
                                   Command="{Binding DataContext.SearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:SymbolIcon Symbol="Warning16" Foreground="#FFB000" Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource Present}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </StackPanel>
</UserControl>
