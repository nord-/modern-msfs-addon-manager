<UserControl x:Class="AddonManager.App.Views.CardDialogInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AddonManager.App.Views">
    <UserControl.Resources>
        <local:PresentToVisibilityConverter x:Key="Present" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Each part collapses when it has nothing to show. -->
        <Style x:Key="CollapseWhenEmpty" TargetType="ItemsControl">
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Built-in parts: dimmed, with the lock icon. -->
        <ItemsControl ItemsSource="{Binding Info.BuiltIns}" Style="{StaticResource CollapseWhenEmpty}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Opacity="0.5" Margin="0,0,0,8">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="LockClosed16" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Package}" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Airports: the title, Replaces built-in, and the other cards at the same Airport as links. -->
        <ItemsControl ItemsSource="{Binding Info.Airports}" Style="{StaticResource CollapseWhenEmpty}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,6">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <TextBlock Text="Replaces built-in" Opacity="0.8"
                                       Visibility="{Binding ReplacesBuiltIn, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding OtherCards}" Style="{StaticResource CollapseWhenEmpty}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,12,0">
                                        <Hyperlink Command="{Binding DataContext.ShowCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding Ref}">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Tags: one read-only line. -->
        <TextBlock Text="{Binding Info.Tags}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding Info.Tags, Converter={StaticResource Present}}" />
    </StackPanel>
</UserControl>
