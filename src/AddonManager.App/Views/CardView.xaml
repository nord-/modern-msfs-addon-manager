<UserControl x:Class="AddonManager.App.Views.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AddonManager.App.Views"
             Width="320" Height="220" Margin="0,0,12,12">
    <UserControl.Resources>
        <local:StateBrushConverter x:Key="StateBrush" />
        <local:TabSymbolConverter x:Key="TabSymbol" />
        <local:PresentToVisibilityConverter x:Key="Present" />
        <local:LockedToVisibilityConverter x:Key="LockedVisibility" />
        <local:JoinConverter x:Key="Join" />
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="Frame" CornerRadius="8" Background="#2B2B2B">
        <Grid>
            <ui:SymbolIcon FontSize="64" Symbol="{Binding Tab, Converter={StaticResource TabSymbol}}"
                           Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Image, Converter={StaticResource Present}, ConverterParameter=Invert}" />
            <Image Source="{Binding Image}" Stretch="UniformToFill" />

            <Border VerticalAlignment="Bottom" Padding="12,28,12,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#E6000000" Offset="0.6" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardText}" Text="{Binding Code}" FontSize="20" FontWeight="Bold"
                               Visibility="{Binding Code, Converter={StaticResource Present}}" />
                    <TextBlock Style="{StaticResource CardText}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                    <TextBlock Style="{StaticResource CardText}" Text="{Binding Subtitle}" Opacity="0.8"
                               Visibility="{Binding Subtitle, Converter={StaticResource Present}}" />
                    <TextBlock Style="{StaticResource CardText}" Text="{Binding CodesLine}" Opacity="0.8"
                               Visibility="{Binding CodesLine, Converter={StaticResource Present}}" />
                    <TextBlock Style="{StaticResource CardText}" Text="{Binding TypeDesignators}" Opacity="0.8"
                               Visibility="{Binding TypeDesignators, Converter={StaticResource Present}}" />
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource CardText}" Text="{Binding PackageCount}" Margin="0,0,8,0" FontSize="12" />
                        <TextBlock Style="{StaticResource CardText}" Text="{Binding Gsx}" Margin="0,0,8,0" FontSize="12"
                                   Visibility="{Binding Gsx, Converter={StaticResource Present}}" />
                        <TextBlock Style="{StaticResource CardText}" Text="{Binding Labels, Converter={StaticResource Join}}" Margin="0,0,8,0" FontSize="12" />
                        <TextBlock Style="{StaticResource CardText}" Text="{Binding WarningsSummary}" Foreground="#FFB000" FontSize="12"
                                   TextWrapping="Wrap" ToolTip="{Binding Warnings, Converter={StaticResource Join}, ConverterParameter='&#10;'}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Ellipse Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                     Fill="{Binding Light, Converter={StaticResource StateBrush}}" />
            <ui:SymbolIcon Symbol="LockClosed16" FontSize="10" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,12,12,0" Visibility="{Binding Light, Converter={StaticResource LockedVisibility}}" />
        </Grid>
    </Border>
</UserControl>
