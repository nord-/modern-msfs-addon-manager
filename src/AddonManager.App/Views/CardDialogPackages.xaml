<UserControl x:Class="AddonManager.App.Views.CardDialogPackages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AddonManager.App.Views">
    <UserControl.Resources>
        <local:PresentToVisibilityConverter x:Key="Present" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- The card's Package rows other than GSX profiles; a locked row is dimmed. -->
    <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,0,0,12" Style="{StaticResource DimmedRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <ui:Button Content="Split" Icon="{ui:SymbolIcon ArrowSplit20}" Margin="0,0,8,0"
                                   Command="{Binding DataContext.SplitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding DataContext.CanSplit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Remove"
                                   Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" ToolTip="{Binding Reason}" ToolTipService.ShowOnDisabled="True"
                                   Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FolderName}" Opacity="0.8" />
                        <TextBlock Text="{Binding Path}" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Opacity="0.8"
                                   Visibility="{Binding Version, Converter={StaticResource Present}}" />
                        <TextBlock Text="{Binding Library, StringFormat='Library: {0}'}" Opacity="0.8" TextWrapping="Wrap"
                                   Visibility="{Binding Library, Converter={StaticResource Present}}" />
                        <TextBlock Text="{Binding ActiveCopy, StringFormat='Active copy: {0}'}" Opacity="0.8" TextWrapping="Wrap"
                                   Visibility="{Binding ActiveCopy, Converter={StaticResource Present}}" />
                        <TextBlock Text="{Binding Reason}" Foreground="#FFB000" TextWrapping="Wrap"
                                   Visibility="{Binding Reason, Converter={StaticResource Present}}" />
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
