<ui:FluentWindow x:Class="AddonManager.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:AddonManager.App.Views"
                 xmlns:vm="clr-namespace:AddonManager.App.ViewModels"
                 Title="Modern MSFS Addon Manager" Width="1280" Height="760" MinWidth="1000" MinHeight="640"
                 WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RescanCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:PresentToVisibilityConverter x:Key="Present" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Modern MSFS Addon Manager" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left menu; Settings is pinned at the bottom. -->
            <DockPanel Grid.Column="0" Width="150" Margin="8" Visibility="{Binding ShowMenu, Converter={StaticResource BoolToVisibility}}">
                <ListBox DockPanel.Dock="Bottom" SelectedValuePath="Tag" SelectedValue="{Binding SelectedMenu, Mode=TwoWay}">
                    <ListBoxItem Content="Settings" Tag="{x:Static vm:MenuSection.Settings}" />
                </ListBox>
                <ListBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedMenu, Mode=TwoWay}">
                    <ListBoxItem Content="Scenery" Tag="{x:Static vm:MenuSection.Scenery}" />
                    <ListBoxItem Content="Aircraft" Tag="{x:Static vm:MenuSection.Aircraft}" />
                    <ListBoxItem Content="Other" Tag="{x:Static vm:MenuSection.Other}" />
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Banner with the rescan button, then the tabs. Hidden behind the first-run and error screens. -->
                <StackPanel Grid.Row="0" Margin="16,8,16,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowFirstRun}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowError}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Rescan (F5)" Command="{Binding RescanCommand}" VerticalAlignment="Top" Margin="12,0,0,0" />
                        <ItemsControl ItemsSource="{Binding BannerLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFB000" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Margin="0,8,0,0"
                             Visibility="{Binding ShowWall, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}" Margin="8,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Grid Grid.Row="1">
                    <local:CardWall Visibility="{Binding ShowWall, Converter={StaticResource BoolToVisibility}}" />
                    <local:SettingsView Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="Scanning…" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowScanning, Converter={StaticResource BoolToVisibility}}" />

                    <!-- The container binds to MainViewModel; the view inside gets its own FirstRunViewModel in code-behind. -->
                    <Grid Visibility="{Binding ShowFirstRun, Converter={StaticResource BoolToVisibility}}">
                        <local:FirstRunView x:Name="FirstRun" />
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640"
                                Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="16" Foreground="#E5484D" />
                        <TextBlock Text="{Binding RetryHint}" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.8"
                                   Visibility="{Binding ShowRetryHint, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Close" Margin="0,16,0,0" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
