<UserControl x:Class="AddonManager.App.Views.CardDialogHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AddonManager.App.Views"
             xmlns:vm="clr-namespace:AddonManager.App.ViewModels">
    <UserControl.Resources>
        <local:PresentToVisibilityConverter x:Key="Present" />
        <local:TabSymbolConverter x:Key="TabSymbol" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Feeds the package thumbnails into the image menu next to its fixed items. -->
        <CollectionViewSource x:Key="ImageChoices" Source="{Binding ImageChoices}" />
        <!-- A provisional card's header is read-only (spec 6.5). -->
        <Style x:Key="EditableBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanEdit}" Value="False">
                    <Setter Property="IsReadOnly" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The card's image, or the placeholder of its tab. -->
        <Border Grid.Column="0" Grid.Row="0" Width="120" Height="90" Background="#1F1F1F" VerticalAlignment="Top" ClipToBounds="True">
            <Grid>
                <ui:SymbolIcon FontSize="40" Symbol="{Binding Tab, Converter={StaticResource TabSymbol}}"
                               Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Image, Converter={StaticResource Present}, ConverterParameter=Invert}" />
                <Image Source="{Binding Image}" Stretch="UniformToFill" />
            </Grid>
        </Border>

        <ui:Button x:Name="ImageButton" Grid.Column="0" Grid.Row="1" Content="Image &#x25BE;" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                   VerticalAlignment="Top" IsEnabled="{Binding CanEdit}" Click="OnImageClick">
            <ui:Button.ContextMenu>
                <ContextMenu>
                    <ContextMenu.Resources>
                        <!-- A generated item is an ImageChoice; the fixed items set their own Command, which wins over this style. -->
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Command" Value="{Binding PlacementTarget.DataContext.SetImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                        <DataTemplate DataType="{x:Type vm:ImageChoice}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Image}" Width="48" Height="36" Stretch="UniformToFill" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ContextMenu.Resources>
                    <ContextMenu.ItemsSource>
                        <CompositeCollection>
                            <CollectionContainer Collection="{Binding Source={StaticResource ImageChoices}}" />
                            <Separator />
                            <MenuItem Header="Choose file&#x2026;" Command="{Binding ChooseImageCommand}" CommandParameter="{x:Null}" />
                            <MenuItem Header="Automatic" Command="{Binding SetImageCommand}" CommandParameter="{x:Null}" />
                        </CompositeCollection>
                    </ContextMenu.ItemsSource>
                </ContextMenu>
            </ui:Button.ContextMenu>
        </ui:Button>

        <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,12,0">
            <TextBox x:Name="NameBox" Style="{StaticResource EditableBox}" Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" FontSize="18"
                     KeyDown="OnNameKeyDown" GotKeyboardFocus="OnNameGotFocus" LostKeyboardFocus="OnNameLostFocus" />

            <!-- ICAO codes as chips, then a box that suggests known Airports. Scenery cards only. -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowCodes, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="ICAO:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding CodeChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3A3A3A" CornerRadius="4" Padding="8,2,2,2" Margin="0,0,6,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" />
                                            <ui:Button Content="&#x00D7;" Padding="6,0" Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" Margin="4,0,0,0" ToolTip="Remove"
                                                       Appearance="Transparent" BorderThickness="0"
                                                       Command="{Binding DataContext.RemoveCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="CodeBox" Style="{StaticResource EditableBox}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" Width="120" Margin="0,0,0,4" Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnCodePreviewKeyDown" LostKeyboardFocus="OnCodeLostFocus" />
                    </WrapPanel>
                </DockPanel>
                <Popup IsOpen="{Binding SuggestionsOpen, Mode=OneWay}" PlacementTarget="{Binding ElementName=CodeBox}" Placement="Bottom"
                       StaysOpen="True" AllowsTransparency="True">
                    <Border Background="#2B2B2B" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" Padding="2" MinWidth="240">
                        <!-- Not focusable, so a click never selects an item: the pick is resolved from the item under the pointer, on press,
                             before the press can reach the dialog and take focus from the code box (which closes the list). -->
                        <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}" Focusable="False"
                                 PreviewMouseLeftButtonDown="OnSuggestionPress">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Code.Value, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
                <TextBlock Text="{Binding CodeMessage}" Foreground="#FFB000" TextWrapping="Wrap"
                           Visibility="{Binding CodeMessage, Converter={StaticResource Present}}" />
            </StackPanel>
        </StackPanel>

        <!-- The switch, its reason and the last message, as in 5b. -->
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,8,12,0">
            <ui:ToggleSwitch OnContent="On" OffContent="Off" IsChecked="{Binding SwitchOn, Mode=OneWay}" Command="{Binding ToggleCommand}"
                             IsEnabled="{Binding CanToggle}" ToolTip="{Binding SwitchReason}" ToolTipService.ShowOnDisabled="True" />
            <TextBlock Text="{Binding SwitchReason}" Foreground="#FFB000" TextWrapping="Wrap"
                       Visibility="{Binding SwitchReason, Converter={StaticResource Present}}" />
            <TextBlock Text="{Binding Message}" Foreground="#FFB000" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding Message, Converter={StaticResource Present}}" />
        </StackPanel>
    </Grid>
</UserControl>
