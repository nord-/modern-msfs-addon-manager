<UserControl x:Class="AddonManager.App.Views.CardDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AddonManager.App.Views"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Border Background="#2B2B2B" CornerRadius="8" Padding="20" Width="640" MaxHeight="620"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
            <!-- The header stays put; the rest scrolls. -->
            <DockPanel DockPanel.Dock="Top">
                <ui:Button DockPanel.Dock="Right" Content="&#x2715;" ToolTip="Close" VerticalAlignment="Top" Click="OnCloseClick" />
                <local:CardDialogHeader />
            </DockPanel>

            <Border DockPanel.Dock="Top" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Margin="0,12,0,0" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>
                    <local:CardDialogPackages />
                    <local:CardDialogInfo />
                    <local:CardDialogGsx />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
